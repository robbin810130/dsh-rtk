{
  "name": "dsh-rtk",
  "version": "1.0.0",
  "description": "DSH plugin: auto-apply the RTK (Runtime Token Keeper) patch to the bash tool packages at every boot, so every agent preset saves tokens on command output.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "schemastery": "^3.5.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robbin810130/dsh-rtk.git"
  },
  "homepage": "https://github.com/robbin810130/dsh-rtk",
  "bugs": {
    "url": "https://github.com/robbin810130/dsh-rtk/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "rtk",
    "token",
    "plugin"
  ],
  "license": "MIT"
}
