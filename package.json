{
  "name": "dsh-rtk",
  "version": "1.3.1",
  "description": "DSH plugin that rewrites bash commands through the supported tools/execute hook.",
  "author": "陈晓斌 <Robbin@MacBook-Pro.local>",
  "type": "module",
  "main": "./dsh-rtk/lib/index.js",
  "exports": {
    ".": {
      "import": "./dsh-rtk/lib/index.js",
      "default": "./dsh-rtk/lib/index.js"
    }
  },
  "files": [
    "dsh-rtk/lib/index.js",
    "scripts/doctor.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "schemastery": "^3.5.2"
  },
  "scripts": {
    "test": "node ./test/marketplace-smoke.mjs && node ./test/resolve.mjs && node ./test/runtime.mjs",
    "doctor": "node ./scripts/doctor.mjs",
    "prepack": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robbin810130/dsh-rtk.git"
  },
  "homepage": "https://github.com/robbin810130/dsh-rtk",
  "bugs": {
    "url": "https://github.com/robbin810130/dsh-rtk/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "rtk",
    "token",
    "plugin"
  ],
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  }
}
